{
  "enabled": true,
  "name": "Doraemon: Kiro is thinking",
  "description": "Tells the Doraemon mascot that a prompt was submitted, so the bubble shows a thinking state while you are away from the IDE.",
  "version": "1",
  "when": {
    "type": "userPromptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force .kiro/doraemon | Out-Null; Set-Content -NoNewline -Path .kiro/doraemon/agent-state.json -Value '{\"state\":\"thinking\",\"message\":\"Kiro is thinking about it~\"}'\""
  }
}
