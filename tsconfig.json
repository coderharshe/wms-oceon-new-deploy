{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // worker.ts imports .open-next/worker.js, which only exists after
  // OpenNext's build step runs — checking it as part of the Next.js app's
  // own tsconfig is a chicken-and-egg failure. It's a 3-line wrapper;
  // wrangler's own build step type-checks it in context when it matters.
  "exclude": ["node_modules", "worker.ts", ".open-next"]
}
